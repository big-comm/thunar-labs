# Maintainer: Tales A. Mendonça <talesam@gmail.com>

pkgname=thunar-labs
pkgdesc="Modern, fast and easy-to-use file manager for Xfce with embedded terminal support"
depends=('desktop-file-utils' 'libexif' 'hicolor-icon-theme' 'libnotify'
         'pcre2' 'libgudev' 'exo' 'libxfce4util' 'libxfce4ui' 'libpng' 'vte3')
makedepends=('git' 'glib2-devel' 'gobject-introspection' 'xfce4-panel' 'xfce4-dev-tools' 'meson' 'ninja')
optdepends=('catfish: file searching'
            'gvfs: trash support, mounting with udisk and remote filesystems'
            'tumbler: thumbnail previews'
            'thunar-volman: removable device management'
            'thunar-archive-plugin: archive creation and extraction'
            'thunar-media-tags-plugin: view/edit ID3/OGG tags')
conflicts=('thunar')
provides=('thunar')
pkgver=$(date +%y.%m.%d)
pkgrel=$(date +%H%M)
arch=('x86_64')
license=('GPL-2.0-or-later' 'LGPL-2.1-only')
groups=('xfce4')
url="https://gitlab.xfce.org/bigbruno/thunar"
source=("git+${url}.git#branch=embedded_terminal_v2")
md5sums=('SKIP')

# Automatically detect and use the correct install file
if [ -e "${pkgname}.install" ]; then
    install=${pkgname}.install
elif [ -e "pkgbuild.install" ]; then
    install=pkgbuild.install
fi

prepare() {
    cd "${srcdir}/thunar"
    # Meson doesn't need autogen.sh
}

build() {
    cd "${srcdir}/thunar"
    
    arch-meson . build \
        --prefix=/usr \
        --sysconfdir=/etc \
        -Dintrospection=enabled \
        -Dgtk_doc=true
    
    meson compile -C build
}

check() {
    cd "${srcdir}/thunar"
    meson test -C build --print-errorlogs || true
}

package() {
    cd "${srcdir}/thunar"
    
    meson install -C build --destdir "$pkgdir"

    # Install license file if present
    if [ -f "COPYING" ]; then
        install -Dm644 COPYING "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
    elif [ -f "LICENSE" ]; then
        install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    fi

    # Install documentation if present
    if [ -f "README.md" ]; then
        install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
    elif [ -f "README" ]; then
        install -Dm644 README "${pkgdir}/usr/share/doc/${pkgname}/README"
    fi
}
